.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/

# videos live only in Notion
*.mp4
*.mov
*.webm
**/video/renders/
**/video/snapshots/
**/video/.hyperframes/

# page check screenshots
.shots/

# HyperFrames installs here first; vendor_skills.sh moves them into .claude/skills/explainer-video/vendor
.agents/

# secrets
.notion-token
.env
.env.*
*.pem
.claude/settings.local.json

# reading site (built by html_utils/build_site.py; CI deploys it)
site/

# temporary pages written by check scripts
.check/

# agent worktrees
.claude/worktrees/

# an article's full text is the author's writing: kept locally (and in the private kb-notes repo), never in this public repo
technical_knowledge_base/whats_new/articles/*/src/inputs/article.txt
