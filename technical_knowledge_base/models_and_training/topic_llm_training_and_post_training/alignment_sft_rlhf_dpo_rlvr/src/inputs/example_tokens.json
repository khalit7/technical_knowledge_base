{
"role": "system",
"content": "You are a helpful assistant."
},
{
"role": "user",
"content": "A shop sells 3 pens for $2. How much do 12 pens cost?"
},
{
"role": "assistant",
"content": "12 pens is 4 groups of 3, so 4 × $2 = $8."
},
{
"role": "user",
"content": "And 30 pens?"
},
{
"role": "assistant",
"content": "30 pens is 10 groups of 3: $20."
}
