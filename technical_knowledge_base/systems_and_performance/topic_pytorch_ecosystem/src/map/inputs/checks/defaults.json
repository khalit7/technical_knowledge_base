{
 "check": "defaults",
 "env": {
  "torch": "2.14.1",
  "python": "3.12.11",
  "machine": "Apple M1 Pro",
  "threads": 8
 },
 "hf_trainer": {
  "max_grad_norm": 1.0,
  "learning_rate": 5e-05,
  "lr_scheduler_type": "linear",
  "warmup_steps": 0,
  "weight_decay": 0.0,
  "optim": "adamw_torch_fused",
  "seed": 42,
  "gradient_accumulation_steps": 1
 },
 "lightning": {
  "gradient_clip_val": null,
  "precision": "32-true",
  "accumulate_grad_batches": 1
 }
}