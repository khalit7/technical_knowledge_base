{
 "torch": "2.14.1",
 "ddp_default_bucket_cap_mb": 25,
 "ddp_first_bucket_bytes": 1048576,
 "ddp_side_stream_env": true,
 "inductor": {
  "cudagraph_trees": true,
  "cudagraph_skip_dynamic_graphs": false,
  "cudagraph_dynamic_shape_warn_limit": 8,
  "cudagraph_unexpected_rerecord_limit": 128,
  "cudagraph_support_input_mutation": true,
  "graph_partition": true
 },
 "skip_reasons_cudagraph_utils": [
  "cpu device (",
  "cudagraph capture requires the caching allocator; ",
  "input storage mutation (",
  "multiple devices: ",
  "mutated inputs",
  "mutated inputs ("
 ],
 "skip_reasons_lowering": [
  "control flow operator: torch.cond.",
  "control flow operator: torch.switch.",
  "control flow operator: torch.while_loop.",
  "index_put_ fallback with boolean indexing is not compatible with CUDA graphs"
 ],
 "make_graphed_callables_num_warmup_iters": 3,
 "capture_error_modes": [
  "global",
  "thread_local",
  "relaxed"
 ],
 "compile_modes": [
  "\"default\", \"reduce-overhead\", \"max-autotune\" or \"max-autotune-no-cudagraphs\""
 ]
}