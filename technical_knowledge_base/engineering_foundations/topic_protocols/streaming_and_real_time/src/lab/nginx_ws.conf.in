# nginx in front of ws_server.py (127.0.0.1:30405) and lab_server.py (30401). @WORK@ is a scratch dir.
worker_processes 1;
error_log @WORK@/ngx_error.log info;
pid @WORK@/ngx.pid;
events { worker_connections 256; use poll; }
http {
  access_log @WORK@/ngx_access.log;
  client_body_temp_path @WORK@/ngx_tmp; proxy_temp_path @WORK@/ngx_tmp;
  # 30410: the documented WebSocket proxy setup, with a short read timeout (2 s) to show idle cuts
  server { listen 127.0.0.1:30410;
    location / { proxy_pass http://127.0.0.1:30405; proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade";
      proxy_read_timeout 2s; } }
  # 30411: the same, but without passing Upgrade and Connection (the classic omission)
  server { listen 127.0.0.1:30411;
    location / { proxy_pass http://127.0.0.1:30405; proxy_http_version 1.1; } }
}
