# kb-os-alloc:1, the memory allocators child's image: the shared lab image plus the three
# alternative allocators Debian 12 packages (jemalloc, gperftools tcmalloc, mimalloc), glibc's
# memusage tools, and the versions recorded.
FROM kb-os-lab:1
RUN apt-get update && apt-get install -y --no-install-recommends \
      libjemalloc2 libgoogle-perftools4 libmimalloc2.0 libc-devtools \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W -f='${Package} ${Version}\n' libc6 libjemalloc2 libgoogle-perftools4 libmimalloc2.0 > /lab/alloc_versions.txt
