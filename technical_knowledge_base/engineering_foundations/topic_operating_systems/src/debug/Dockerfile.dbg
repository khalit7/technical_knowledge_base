# kb-os-dbg:1, the Debug lab's own image: the shared lab image plus two libraries that ML jobs
# really use and that appear in the failures reproduced here: Hugging Face tokenizers (a Rust
# thread pool that warns when a process forks after using it) and pyarrow (the column store
# the copy-on-write fix can use).
FROM kb-os-lab:1
RUN pip install --no-cache-dir tokenizers pyarrow \
    && python -c "import tokenizers, pyarrow; open('/lab/dbg_versions.txt','w').write(f'tokenizers {tokenizers.__version__}\npyarrow {pyarrow.__version__}\n')"
