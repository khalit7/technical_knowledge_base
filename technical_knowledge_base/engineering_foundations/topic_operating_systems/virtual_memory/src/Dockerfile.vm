# kb-os-vm:1, the virtual memory child's image: the shared lab image plus safetensors (and packaging, which
# safetensors.torch imports).
FROM kb-os-lab:1
RUN /opt/venv/bin/pip install --no-cache-dir safetensors packaging && /opt/venv/bin/pip freeze | grep -iE 'safetensors|packaging' > /lab/vm_extra.txt
