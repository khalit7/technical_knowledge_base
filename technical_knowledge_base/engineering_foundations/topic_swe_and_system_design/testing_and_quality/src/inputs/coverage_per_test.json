 "lines": {
  "1": "\"\"\"When and how long to wait before retrying a failed call to the model provider.\"\"\"",
  "2": "",
  "3": "RETRYABLE = frozenset({408, 429, 500, 502, 503, 504})",
  "4": "",
  "5": "",
  "6": "def should_retry(status: int, attempt: int, max_attempts: int = 3) -> bool:",
  "7": "    \"\"\"attempt counts from 1: the number of calls made so far.\"\"\"",
  "8": "    if attempt >= max_attempts:",
  "9": "        return False",
  "10": "    return status in RETRYABLE",
  "11": "",
  "12": "",
  "13": "def backoff_delay(attempt: int, base: float = 0.5, cap: float = 8.0) -> float:",
  "14": "    \"\"\"Seconds to wait after the given attempt: 0.5, 1, 2, 4, 8, 8, ...\"\"\"",
  "15": "    return min(cap, base * 2 ** (attempt - 1))",
  "16": "",
  "17": "",
  "18": "def parse_retry_after(value: str | None) -> float | None:",
  "19": "    \"\"\"Read a Retry-After header given in seconds; None if absent or not a number.\"\"\"",
  "20": "    if value is None:",
  "21": "        return None",
  "22": "    try:",
  "23": "        seconds = float(value)",
  "24": "    except ValueError:",
  "25": "        return None",
  "26": "    return max(0.0, seconds)"
 },
