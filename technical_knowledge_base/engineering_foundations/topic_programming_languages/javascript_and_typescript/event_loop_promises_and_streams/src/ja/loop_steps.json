{
 "l1_basic.mjs": [
  {
   "l": [],
   "s": [
    "module"
   ],
   "cap": "Node starts running the module's top-level code. That whole run is one piece of synchronous work on the call stack.",
   "h": "The module starts"
  },
  {
   "l": [
    1
   ],
   "s": [
    "module",
    "console.log"
   ],
   "o": "A",
   "cap": "Line 1 prints A at once.",
   "h": "A prints"
  },
  {
   "l": [
    2
   ],
   "s": [
    "module",
    "setTimeout"
   ],
   "t": [
    "() => log(\"B\") (0 ms)"
   ],
   "cap": "<code>setTimeout</code> registers its callback with the timers queue and returns. A delay of 0 means \"as soon as the loop gets to timers\", never \"now\".",
   "h": "A timer is registered"
  },
  {
   "l": [
    3
   ],
   "s": [
    "module",
    "then"
   ],
   "m": [
    "() => log(\"C\")"
   ],
   "t": [
    "() => log(\"B\") (0 ms)"
   ],
   "cap": "The promise is already resolved, so <code>.then</code> puts its callback straight into the microtask queue.",
   "h": "A microtask is queued"
  },
  {
   "l": [
    4
   ],
   "s": [
    "module",
    "console.log"
   ],
   "o": "D",
   "cap": "Line 4 prints D. Synchronous code always finishes before any queued callback.",
   "h": "D prints"
  },
  {
   "l": [],
   "s": [],
   "cap": "The module is done and the stack is empty. Before the loop may take a macrotask, it drains the microtask queue.",
   "h": "The stack empties"
  },
  {
   "l": [
    3
   ],
   "s": [
    "then callback"
   ],
   "m": [],
   "o": "C",
   "cap": "The promise callback prints C.",
   "h": "C runs first"
  },
  {
   "l": [
    2
   ],
   "s": [
    "timer callback"
   ],
   "t": [],
   "o": "B",
   "cap": "Microtasks are empty, so the loop moves to the timers phase: the 0 ms timer is due and prints B.",
   "h": "Then B"
  },
  {
   "l": [],
   "s": [],
   "cap": "Nothing is queued and nothing is pending: the process exits.",
   "h": "Exit"
  }
 ],
 "l2_await.mjs": [
  {
   "l": [
    1,
    2,
    3,
    4,
    5
   ],
   "s": [
    "module"
   ],
   "cap": "Lines 1 to 5 only define <code>job</code>; nothing in it runs yet.",
   "h": "A definition only"
  },
  {
   "l": [
    6
   ],
   "s": [
    "module",
    "console.log"
   ],
   "o": "main start",
   "cap": "Prints \"main start\".",
   "h": "main start prints"
  },
  {
   "l": [
    7
   ],
   "s": [
    "module",
    "setTimeout"
   ],
   "t": [
    "() => log(\"timer\")"
   ],
   "cap": "<code>setTimeout(f, 0)</code> registers the timer callback.",
   "h": "A timer is registered"
  },
  {
   "l": [
    8,
    2
   ],
   "s": [
    "module",
    "job"
   ],
   "o": "job start",
   "cap": "Calling <code>job()</code> runs its body synchronously, like any function, up to the first <code>await</code>.",
   "h": "job() runs at once"
  },
  {
   "l": [
    3
   ],
   "s": [
    "module"
   ],
   "m": [
    "job: continue after await"
   ],
   "cap": "<code>await null</code> suspends <code>job</code>: the rest of the function is queued as a microtask (the awaited value is already there), and <code>job()</code> returns a pending promise to line 8.",
   "h": "await suspends job"
  },
  {
   "l": [
    9
   ],
   "s": [
    "module",
    "then"
   ],
   "m": [
    "job: continue after await",
    "() => log(\"then\")"
   ],
   "cap": "The <code>.then</code> callback queues behind <code>job</code>'s continuation: microtasks run in the order they were queued.",
   "h": "then queues behind it"
  },
  {
   "l": [
    10
   ],
   "s": [
    "module",
    "console.log"
   ],
   "o": "main end",
   "cap": "Prints \"main end\". The module is finished.",
   "h": "main end prints"
  },
  {
   "l": [
    4
   ],
   "s": [
    "job (resumed)"
   ],
   "m": [
    "() => log(\"then\")"
   ],
   "o": "job resumed",
   "cap": "Draining microtasks: <code>job</code> resumes after its <code>await</code> and prints.",
   "h": "job resumes"
  },
  {
   "l": [
    9
   ],
   "s": [
    "then callback"
   ],
   "m": [],
   "o": "then",
   "cap": "Next microtask: the <code>.then</code> callback.",
   "h": "then runs"
  },
  {
   "l": [
    7
   ],
   "s": [
    "timer callback"
   ],
   "t": [],
   "o": "timer",
   "cap": "Only now, with microtasks empty, does the timer run.",
   "h": "The timer, last"
  },
  {
   "l": [],
   "s": [],
   "cap": "Nothing is queued and nothing is pending: the process exits.",
   "h": "Exit"
  }
 ],
 "l3_chain.mjs": [
  {
   "l": [
    1,
    2,
    3,
    4
   ],
   "s": [
    "module",
    "setTimeout"
   ],
   "t": [
    "timer 1 callback"
   ],
   "cap": "Lines 1 to 4: <code>setTimeout</code> registers timer 1 and returns at once.",
   "h": "Timer 1 is registered"
  },
  {
   "l": [
    5
   ],
   "s": [
    "module",
    "setTimeout"
   ],
   "t": [
    "timer 1 callback",
    "timer 2 callback"
   ],
   "cap": "Timer 2 is registered behind it, due at the same time.",
   "h": "Timer 2 is registered"
  },
  {
   "l": [
    6,
    7
   ],
   "s": [
    "module",
    "then"
   ],
   "m": [
    "() => log(\"then 1\")"
   ],
   "cap": "\"then 1\" is queued: its promise is already resolved.",
   "h": "then 1 is queued"
  },
  {
   "l": [
    8
   ],
   "s": [
    "module",
    "then"
   ],
   "cap": "\"then 2\" is attached to the promise <i>returned by</i> the first <code>.then</code>, which is still pending. It is not queued yet.",
   "h": "then 2 waits"
  },
  {
   "l": [
    9
   ],
   "s": [
    "module",
    "console.log"
   ],
   "o": "sync",
   "cap": "Prints \"sync\"; the module is done.",
   "h": "sync prints"
  },
  {
   "l": [
    7
   ],
   "s": [
    "then 1 callback"
   ],
   "m": [],
   "o": "then 1",
   "cap": "Draining microtasks: \"then 1\" runs, and its promise fulfils...",
   "h": "then 1 runs"
  },
  {
   "l": [
    8
   ],
   "s": [
    "then 2 callback"
   ],
   "o": "then 2",
   "cap": "...which queues \"then 2\" at once, and the drain keeps going until the queue is empty, so \"then 2\" runs before any timer.",
   "h": "then 2 runs at once"
  },
  {
   "l": [
    2
   ],
   "s": [
    "timer 1 callback"
   ],
   "t": [
    "timer 2 callback"
   ],
   "o": "timer 1",
   "cap": "Timers phase: timer 1 runs.",
   "h": "Timer 1 runs"
  },
  {
   "l": [
    3
   ],
   "s": [
    "timer 1 callback",
    "then"
   ],
   "m": [
    "() => log(\"micro from timer 1\")"
   ],
   "cap": "Timer 1 queues a microtask.",
   "h": "A microtask from a timer"
  },
  {
   "l": [
    3
   ],
   "s": [
    "then callback"
   ],
   "m": [],
   "o": "micro from timer 1",
   "cap": "After each macrotask, Node drains microtasks before the next timer, so this beats timer 2, which was due at the same time.",
   "h": "It runs before timer 2"
  },
  {
   "l": [
    5
   ],
   "s": [
    "timer 2 callback"
   ],
   "t": [],
   "o": "timer 2",
   "cap": "Then timer 2.",
   "h": "Timer 2"
  },
  {
   "l": [],
   "s": [],
   "cap": "Nothing is queued and nothing is pending: the process exits.",
   "h": "Exit"
  }
 ],
 "l4_node.mjs": [
  {
   "l": [
    2
   ],
   "s": [
    "module",
    "fs.readFile"
   ],
   "io": [
    "read l4_node.mjs"
   ],
   "cap": "<code>readFile</code> hands the read to libuv (a thread pool in C) and returns at once.",
   "h": "The read goes to libuv"
  },
  {
   "l": [],
   "s": [],
   "cap": "The module is done. Nothing is queued, so the loop waits in its poll phase for I/O to finish.",
   "h": "The loop waits in poll"
  },
  {
   "l": [
    2
   ],
   "s": [
    "readFile callback"
   ],
   "io": [],
   "cap": "Poll phase: the read finished, and its callback runs.",
   "h": "The I/O callback runs"
  },
  {
   "l": [
    3
   ],
   "s": [
    "readFile callback",
    "setTimeout"
   ],
   "t": [
    "() => log(\"setTimeout\")"
   ],
   "cap": "<code>setTimeout(f, 0)</code> registers a timer for the next pass through the timers phase.",
   "h": "A timer"
  },
  {
   "l": [
    4
   ],
   "s": [
    "readFile callback",
    "setImmediate"
   ],
   "c": [
    "() => log(\"setImmediate\")"
   ],
   "cap": "<code>setImmediate</code> queues for the check phase, which comes right after poll.",
   "h": "An immediate"
  },
  {
   "l": [
    5
   ],
   "s": [
    "readFile callback",
    "then"
   ],
   "m": [
    "() => log(\"promise\")"
   ],
   "cap": "<code>Promise.resolve().then</code> queues its callback as a microtask.",
   "h": "A microtask"
  },
  {
   "l": [
    6
   ],
   "s": [
    "readFile callback",
    "nextTick"
   ],
   "n": [
    "() => log(\"nextTick\")"
   ],
   "cap": "A <code>nextTick</code> callback: Node's own queue, not part of the language.",
   "h": "A nextTick callback"
  },
  {
   "l": [
    7
   ],
   "s": [
    "readFile callback",
    "console.log"
   ],
   "o": "I/O callback",
   "cap": "Prints \"I/O callback\" and the callback returns.",
   "h": "I/O callback prints"
  },
  {
   "l": [
    6
   ],
   "s": [
    "nextTick callback"
   ],
   "n": [],
   "o": "nextTick",
   "cap": "Between callbacks Node drains the nextTick queue first...",
   "h": "nextTick first"
  },
  {
   "l": [
    5
   ],
   "s": [
    "then callback"
   ],
   "m": [],
   "o": "promise",
   "cap": "...then the microtask queue.",
   "h": "Then the promise"
  },
  {
   "l": [
    4
   ],
   "s": [
    "immediate callback"
   ],
   "c": [],
   "o": "setImmediate",
   "cap": "The loop continues from poll to check: <code>setImmediate</code> runs before the timer, because timers come in the <i>next</i> iteration.",
   "h": "Check before timers"
  },
  {
   "l": [
    3
   ],
   "s": [
    "timer callback"
   ],
   "t": [],
   "o": "setTimeout",
   "cap": "Next iteration, timers phase: the 0 ms timer prints last.",
   "h": "Timers, next turn"
  },
  {
   "l": [],
   "s": [],
   "cap": "Nothing is queued and nothing is pending: the process exits.",
   "h": "Exit"
  }
 ],
