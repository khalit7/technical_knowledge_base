"""Type stubs for the tokrs extension: what mypy, ty and your editor see."""
import os

import numpy as np
import numpy.typing as npt

Report = tuple[int, int, int, int, dict[str, int]]

def noop() -> None: ...
def count_tokens(text: str) -> int: ...
def count_many(texts: list[str]) -> list[int]: ...
def count_many_owned(texts: list[str]) -> list[int]: ...
def total_len(texts: list[str]) -> int: ...
def total_len_owned(texts: list[str]) -> int: ...
def count_bytes(data: bytes) -> int: ...
def count_bytes_owned(data: bytes) -> int: ...
def tally_bytes(data: bytes) -> Report: ...
def tally_bytes_detached(data: bytes) -> Report: ...
def tally_bytes_parallel(data: bytes, threads: int = 8) -> Report: ...
def tally_file(path: str | os.PathLike[str], threads: int = 1) -> Report: ...
def sum_sq_list(xs: list[float]) -> float: ...
def sum_sq_array(xs: npt.NDArray[np.float64]) -> float: ...
def counts_list(texts: list[str]) -> list[int]: ...
def counts_array(texts: list[str]) -> npt.NDArray[np.uint64]: ...
def dict_total(d: dict[str, int]) -> int: ...
def dict_total_owned(d: dict[str, int]) -> int: ...
def parse_line(line: str) -> tuple[str, int]: ...
def first_token_len(text: str) -> int: ...

class MalformedLine(Exception): ...

class Counter:
    def __init__(self) -> None: ...
    def add(self, user: str, text: str) -> None: ...
    def top(self, n: int = 5) -> list[tuple[str, int]]: ...
    @property
    def total(self) -> int: ...
    def __len__(self) -> int: ...

class SharedCounter:
    def __init__(self) -> None: ...
    def add(self, user: str, text: str) -> None: ...
    @property
    def total(self) -> int: ...
