 "claims": [
  {
   "claim": "The Mean column of Table 3 averages the five buckets",
   "where": "Table 3",
   "ok": true,
   "note": "every printed Mean is the unweighted mean of the five buckets (to rounding), so the 52 questions under lag 64 count for 40% of it although they are 8% of the 639"
  },
  {
   "claim": "M.4 Hebbian leads at 10x with the best mean (11.6%)",
   "where": "\u00a76.4",
   "ok": false,
   "note": "M.3 KV Ext has the best printed mean at 10x (12.05 against 11.60). Weighted by questions per bucket M.4 does lead (10.60 against 10.17), and it has the best long-lag score (10.32); either gap is inside the noise"
  },
  {
   "claim": "M.3 KV Ext achieves the highest short-lag recall at 10x (15.6%)",
   "where": "\u00a76.4",
   "ok": false,
   "note": "M.4 Hebbian is higher at 0-31 (15.86 against 15.58)"
  },
  {
   "claim": "M.6 Slot achieves the highest terminal K30 = 9.7%",
   "where": "\u00a76.5",
   "ok": false,
   "note": "M.2 XAttn (11.04) and M.4 Hebbian (10.62) are higher; M.6 has the highest dK"
  },
  {
   "claim": "1x ordering M.2 > M.6 > M.4 >> M.5 > M.1 ~ M.3 ~ baseline",
   "where": "\u00a76.4",
   "ok": true,
   "note": "by the printed means"
  },
  {
   "claim": "M.2 and M.6 short-lag recall above 17% at 1x, long-lag about 9% and 7%",
   "where": "\u00a76.4",
   "ok": true,
   "note": "17.85 and 17.21; 9.02 and 7.08"
  },
  {
   "claim": "M.4 nearly flat at about 9.3% at 1x",
   "where": "\u00a76.4",
   "ok": true,
   "note": "9.51 to 9.23"
  },
  {
   "claim": "All six methods positive net benefit at 10x, range +1.8 to 6.3%",
   "where": "\u00a77.2",
   "ok": true,
   "note": "1.83 to 6.26"
  },
  {
   "claim": "Adapter tax modest, 2 to 4% across all conditions",
   "where": "\u00a77.2",
   "ok": true,
   "note": "taxes run 2.38 to 4.23 F1 points: right, rounded. But against a baseline F1 of 6.44 that is a loss of 37% to 66% of what the model answered before"
  },
  {
   "claim": "At most 640 slots, about 5 MB at float32",
   "where": "\u00a77.4",
   "ok": true,
   "note": "640 x 2048 x 4 bytes = 5.24 MB (5.00 MiB)"
  },
  {
   "claim": "M.2 adds about 16.8M parameters (0.6%)",
   "where": "\u00a74.2, Table 2",
   "ok": true,
   "note": "4 x 2048^2 + 24 = 16777240 (0.59% of 2.85B)"
  },
  {
   "claim": "M.3 adds about 4.2M (0.1%)",
   "where": "\u00a74.3",
   "ok": true,
   "note": "2048^2 = 4,194,304 (0.15%)"
  },
  {
   "claim": "M.4 adds 1.0M; M.5 21.0M",
   "where": "Table 2",
   "ok": true,
   "note": "M.4: 2 x 2048 x 256; M.5: 3 x 2048^2 + 2048 x 4096 + 2048 (no output projection). At 10x, M.4 has 2 x 2048 x 810 = 3.3M"
  },
  {
   "claim": "The 10x Hebbian memory is 10x the capacity of 1x",
   "where": "\u00a76.4",
   "ok": true,
   "note": "810^2 / 256^2 = 10.01: d_h was chosen so the matrix has 10x the entries"
  },
  {
   "claim": "Methods that succeed at both scales use write mechanisms that are inherently more selective (attention-coupled for M.2)",
   "where": "\u00a76.4",
   "ok": false,
   "note": "M.2 uses the identical attention-coupled write as M.1, M.3 and M.5 (Table 1, Eqs. 7, 10, 15, 23); only its read differs"
  },
  {
   "claim": "Methods with learned selective writes (M.2, M.4, M.6)",
   "where": "\u00a77.1",
   "ok": false,
   "note": "Sec. 5 says the write-side projections get no gradient and stay at their random initialisation"
  },
  {
   "claim": "Methods with explicit gating (M.5, M.6)",
   "where": "\u00a77.2",
   "ok": false,
   "note": "M.6 has no gate (Eqs. 24 to 30)"
  },
  {
   "claim": "A stateless baseline accumulates dK = 5.6% because more context is injected into the current prompt",
   "where": "\u00a76.5",
   "ok": false,
   "note": "the equal-input principle (\u00a76.2) gives the baseline only the current turn; K1 = 0 and K30 = 5.57 means the answerable question set changed, not the baseline"
  },
  {
   "claim": "Trained on the public training split of LoCoMo",
   "where": "\u00a76.2",
   "ok": false,
   "note": "LoCoMo releases 10 conversations as an evaluation benchmark with no training split; the 639 test questions match the last three conversations (conv-48, 49, 50) to within 4 per bucket"
  }
