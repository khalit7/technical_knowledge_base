# Two "front-end servers" of one fleet (instance A on @PA@ and @PA2@, instance B on @PB@) sharing one session ticket key,
# both with TLS 1.3 early data on, in front of backend.py. Filled in by zero_rtt.py.
worker_processes 1;
daemon off;
pid @W@/@NAME@.pid;
error_log @W@/@NAME@_error.log info;
events { worker_connections 64; use poll; }
http {
  access_log @W@/@NAME@_access.log;
  client_body_temp_path @W@/ngx_tmp; proxy_temp_path @W@/ngx_tmp; fastcgi_temp_path @W@/ngx_tmp; uwsgi_temp_path @W@/ngx_tmp; scgi_temp_path @W@/ngx_tmp;
  ssl_certificate @PKI@/fullchain.pem; ssl_certificate_key @PKI@/leaf.key;
  ssl_protocols TLSv1.3; ssl_early_data on;
  ssl_session_tickets on; ssl_session_ticket_key @W@/ticket.key;
  @SERVERS@
}
