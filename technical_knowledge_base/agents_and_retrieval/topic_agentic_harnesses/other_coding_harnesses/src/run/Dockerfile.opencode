FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 git ca-certificates ripgrep && rm -rf /var/lib/apt/lists/*
RUN npm install -g opencode-ai@1.18.34 && opencode --version
ENV HOME=/home/run
RUN mkdir -p /home/run && git config --system user.name harness-run && git config --system user.email run@example.invalid
WORKDIR /work
