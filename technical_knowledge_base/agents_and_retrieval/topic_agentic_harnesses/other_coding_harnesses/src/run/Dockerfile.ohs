FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tmux git && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir openhands-sdk==1.53.0 openhands-tools==1.53.0
RUN git config --system user.name harness-run && git config --system user.email run@example.invalid
WORKDIR /work
