     "file_path": "/work/cc/w_content/tests/test_core.py",
     "content": "import sys, os; sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\nfrom textstats import word_count, top_words\n\n\ndef test_word_count_simple():\n    assert word_count(\"the cat sat\") == 3\n\n\ndef test_apostrophes_kept():\n    assert word_count(\"don't stop\") == 2\n\n\ndef test_top_words_ties_alphabetical():\n    assert top_words(\"b a b a c\", n=2) == [(\"a\", 2), (\"b\", 2)]\n\n\nif __name__ == \"__main__\":\n    import sys\n    failed = 0\n    for name, fn in sorted(globals().items()):\n        if name.startswith(\"test_\") and callable(fn):\n            try:\n                fn()\n                print(\"PASS\", name)\n            except AssertionError as e:\n                failed += 1\n                print(\"FAIL\", name, e)\n    print(f\"{failed} failed\")\n    sys.exit(1 if failed else 0)\n"
    }
